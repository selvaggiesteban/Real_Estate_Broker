---
import type { Property } from '../lib/types';
import { formatPrice, formatSuperficie } from '../lib/format';

interface Props {
  property: Property;
}

const { property } = Astro.props;
const href = `/propiedades/${property.slug}`;
const esVenta = property.operacion === 'venta';
---

<article class="card group overflow-hidden transition hover:-translate-y-0.5 hover:shadow-lg">
  <a href={href} class="block focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600">
    <div class="relative aspect-[4/3] overflow-hidden bg-slate-100">
      <img
        src={property.imagenes[0]}
        alt={property.titulo}
        loading="lazy"
        decoding="async"
        width="640"
        height="480"
        class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.04]"
      />
      <div class="absolute left-3 top-3 flex gap-2">
        <span
          class:list={[
            'rounded-md px-2.5 py-1 text-xs font-bold uppercase tracking-wide text-white shadow',
            esVenta ? 'bg-accent-500' : 'bg-brand-600',
          ]}
        >
          {esVenta ? 'Venta' : 'Alquiler'}
        </span>
        <span class="rounded-md bg-white/95 px-2.5 py-1 text-xs font-semibold capitalize text-slate-700 shadow">
          {property.tipo === 'ph' ? 'PH' : property.tipo}
        </span>
      </div>
      {
        property.destacada && (
          <span class="absolute right-3 top-3 inline-flex items-center gap-1 rounded-md border border-slate-900 bg-white/95 px-2.5 py-1 text-xs font-bold uppercase tracking-wide text-slate-900 shadow">
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5" aria-hidden="true">
              <path d="M12 2.5l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.3l-5.8 3.1 1.1-6.5L2.6 9.3l6.5-.9L12 2.5z" />
            </svg>
            Destacada
          </span>
        )
      }
    </div>

    <div class="flex flex-col gap-2 p-4">
      <p class="flex items-center gap-1 text-xs font-medium text-slate-500">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 shrink-0 text-slate-400" aria-hidden="true">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 1 1 16 0Z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        {property.zona} · {property.localidad}
      </p>

      <h3 class="line-clamp-2 min-h-[2.5rem] text-[15px] font-semibold leading-snug text-slate-900 transition group-hover:text-brand-700">
        {property.titulo}
      </h3>

      <p class="text-lg font-extrabold tracking-tight text-brand-900">
        {formatPrice(property.precio, property.moneda)}
        {property.operacion === 'alquiler' && <span class="text-sm font-semibold text-slate-500">/mes</span>}
      </p>

      {
        property.expensas !== undefined && (
          <p class="text-xs text-slate-500">+ Expensas {formatPrice(property.expensas, 'ARS')}</p>
        )
      }

      <ul class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 border-t border-slate-100 pt-3 text-xs font-medium text-slate-600" aria-label="Características principales">
        {
          property.ambientes > 0 && (
            <li class="flex items-center gap-1">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-3.5 w-3.5 text-slate-400" aria-hidden="true">
                <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                <rect x="14" y="14" width="7" height="7" rx="1"></rect>
              </svg>
              {property.ambientes === 1 ? '1 ambiente' : `${property.ambientes} amb.`}
            </li>
          )
        }
        {
          property.dormitorios > 0 && (
            <li class="flex items-center gap-1">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 text-slate-400" aria-hidden="true">
                <path d="M2 10v10"></path>
                <path d="M2 17h20"></path>
                <path d="M22 17v-4a3 3 0 0 0-3-3H8v7"></path>
                <circle cx="6" cy="11" r="1.5"></circle>
              </svg>
              {property.dormitorios} dorm.
            </li>
          )
        }
        {
          property.banios > 0 && (
            <li class="flex items-center gap-1">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 text-slate-400" aria-hidden="true">
                <path d="M4 12h16a1 1 0 0 1 1 1 7 7 0 0 1-7 7h-4a7 7 0 0 1-7-7 1 1 0 0 1 1-1Z"></path>
                <path d="M6 12V5a2 2 0 0 1 4 0"></path>
              </svg>
              {property.banios} baños
            </li>
          )
        }
        <li class="flex items-center gap-1">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 text-slate-400" aria-hidden="true">
            <path d="M3 8V3h5"></path>
            <path d="M21 8V3h-5"></path>
            <path d="M3 16v5h5"></path>
            <path d="M21 16v5h-5"></path>
          </svg>
          {formatSuperficie(property.superficieTotal)}
        </li>
      </ul>

      <p class="mt-1 truncate text-xs text-slate-400">{property.inmobiliaria.nombre}</p>
    </div>
  </a>
</article>
