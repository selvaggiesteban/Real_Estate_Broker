---
import { TIPOS_PROPIEDAD } from '../lib/types';
import type { SearchFilters, TipoPropiedad } from '../lib/types';

interface Props {
  variant?: 'hero' | 'compact';
  filters?: SearchFilters;
  zonas: string[];
}

const { variant = 'hero', filters, zonas } = Astro.props;

const operacion = filters?.operacion ?? 'venta';
const tipoSeleccionado = filters?.tipos[0] ?? '';
const ambientes = filters?.ambientes ? String(filters.ambientes) : '';
const precioMin = filters?.precioMin !== undefined ? String(filters.precioMin) : '';
const precioMax = filters?.precioMax !== undefined ? String(filters.precioMax) : '';
const zonaSeleccionada = filters?.zonas[0] ?? '';

const tipoLabels: Record<TipoPropiedad, string> = {
  departamento: 'Departamento',
  casa: 'Casa',
  ph: 'PH',
  terreno: 'Terreno',
  oficina: 'Oficina',
  local: 'Local comercial',
};

const isHero = variant === 'hero';
---

<form
  action="/propiedades"
  method="get"
  class:list={[
    'rounded-2xl border border-slate-200 bg-white p-4 shadow-xl sm:p-5',
    isHero && 'sm:p-6',
  ]}
  data-search-bar
>
  <div class="inline-flex rounded-lg border border-slate-200 bg-slate-100 p-1" role="radiogroup" aria-label="Tipo de operación">
    {
      (['venta', 'alquiler'] as const).map((op) => (
        <label
          class:list={[
            'relative cursor-pointer rounded-md px-5 py-2 text-sm font-semibold transition',
            operacion === op
              ? 'bg-white text-brand-900 shadow-sm'
              : 'text-slate-500 hover:text-slate-700',
          ]}
        >
          <input
            type="radio"
            name="operacion"
            value={op}
            class="peer sr-only"
            checked={operacion === op}
          />
          {op === 'venta' ? 'Comprar' : 'Alquilar'}
        </label>
      ))
    }
  </div>

  <div class:list={[
    'mt-4 grid gap-3',
    isHero ? 'sm:grid-cols-2 lg:grid-cols-5' : 'sm:grid-cols-3 lg:grid-cols-6',
  ]}>
    <div class={isHero ? '' : 'lg:col-span-1'}>
      <label for={`tipo-${variant}`} class="mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-500">Tipo</label>
      <select id={`tipo-${variant}`} name="tipo" class="input-base">
        <option value="">Todos</option>
        {
          TIPOS_PROPIEDAD.map((tipo) => (
            <option value={tipo} selected={tipoSeleccionado === tipo}>
              {tipoLabels[tipo]}
            </option>
          ))
        }
      </select>
    </div>

    <div class={isHero ? '' : 'lg:col-span-1'}>
      <label for={`zona-${variant}`} class="mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-500">Zona</label>
      <input
        id={`zona-${variant}`}
        type="text"
        name="zona"
        list={`zonas-${variant}`}
        value={zonaSeleccionada}
        placeholder="Ej: Palermo"
        autocomplete="off"
        class="input-base"
      />
      <datalist id={`zonas-${variant}`}>
        {zonas.map((zona) => <option value={zona} />)}
      </datalist>
    </div>

    <div>
      <label for={`ambientes-${variant}`} class="mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-500">Ambientes</label>
      <select id={`ambientes-${variant}`} name="ambientes" class="input-base">
        <option value="">Cualquiera</option>
        {[1, 2, 3, 4, 5].map((n) => (
          <option value={n} selected={ambientes === String(n)}>{n}{n === 5 ? ' o más' : ''}</option>
        ))}
      </select>
    </div>

    <div>
      <label for={`precio-min-${variant}`} class="mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-500">Precio mín.</label>
      <input id={`precio-min-${variant}`} type="number" name="precio_min" min="0" step="1000" value={precioMin} placeholder="Sin límite" class="input-base" />
    </div>

    <div>
      <label for={`precio-max-${variant}`} class="mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-500">Precio máx.</label>
      <input id={`precio-max-${variant}`} type="number" name="precio_max" min="0" step="1000" value={precioMax} placeholder="Sin límite" class="input-base" />
    </div>

    <div class:list={[isHero && 'sm:col-span-2 lg:col-span-5', !isHero && 'lg:col-span-6']}>
      <button type="submit" class:list={['w-full', 'btn-primary', isHero && 'py-3 text-base']}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-4 w-4" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        Buscar propiedades
      </button>
    </div>
  </div>
</form>
