---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FilterSidebar from '../../components/FilterSidebar.astro';
import PropertyCard from '../../components/PropertyCard.astro';
import Pagination from '../../components/Pagination.astro';
import { applySearch, countActiveFilters, filtersToSearchParams, parseFilters } from '../../lib/search';
import { getAllProperties, getTipoCounts } from '../../lib/properties';
import { ORDENES, ORDENES_LABEL } from '../../lib/types';
import type { SearchFilters, TipoPropiedad } from '../../lib/types';

const filters = parseFilters(Astro.url.searchParams);
const result = applySearch(getAllProperties(), filters);
const tipoCounts = getTipoCounts();

const zonasMap = new Map<string, number>();
for (const property of getAllProperties()) {
  zonasMap.set(property.zona, (zonasMap.get(property.zona) ?? 0) + 1);
}
const zonas = [...zonasMap.entries()]
  .map(([nombre, total]) => ({ nombre, total }))
  .sort((a, b) => a.nombre.localeCompare(b.nombre, 'es'));

function chipHref(mutate: (draft: SearchFilters) => void): string {
  const draft: SearchFilters = {
    ...filters,
    tipos: [...filters.tipos],
    zonas: [...filters.zonas],
    page: 1,
  };
  mutate(draft);
  const query = filtersToSearchParams(draft).toString();
  return query ? `/propiedades?${query}` : '/propiedades';
}

const tipoLabel = (tipo: TipoPropiedad) => (tipo === 'ph' ? 'PH' : `${tipo.charAt(0).toUpperCase()}${tipo.slice(1)}s`);

const chips: { label: string; href: string }[] = [];
if (filters.operacion) {
  chips.push({
    label: filters.operacion === 'venta' ? 'En venta' : 'En alquiler',
    href: chipHref((draft) => {
      delete draft.operacion;
    }),
  });
}
for (const tipo of filters.tipos) {
  chips.push({ label: tipoLabel(tipo), href: chipHref((draft) => {
    draft.tipos = draft.tipos.filter((item) => item !== tipo);
  }) });
}
for (const zona of filters.zonas) {
  chips.push({ label: `Zona: ${zona}`, href: chipHref((draft) => {
    draft.zonas = draft.zonas.filter((item) => item !== zona);
  }) });
}
if (filters.ambientes) {
  chips.push({
    label: filters.ambientes === 1 ? '1 ambiente' : `${filters.ambientes} ambientes`,
    href: chipHref((draft) => {
      delete draft.ambientes;
    }),
  });
}
if (filters.precioMin !== undefined) {
  chips.push({
    label: `Desde ${filters.precioMin}`,
    href: chipHref((draft) => {
      delete draft.precioMin;
    }),
  });
}
if (filters.precioMax !== undefined) {
  chips.push({
    label: `Hasta ${filters.precioMax}`,
    href: chipHref((draft) => {
      delete draft.precioMax;
    }),
  });
}
if (filters.superficieMin !== undefined) {
  chips.push({
    label: `Desde ${filters.superficieMin} m²`,
    href: chipHref((draft) => {
      delete draft.superficieMin;
    }),
  });
}

const activeCount = countActiveFilters(filters);
const operacionLabel = filters.operacion === 'venta' ? 'venta' : filters.operacion === 'alquiler' ? 'alquiler' : 'venta y alquiler';
const title = `Propiedades en ${operacionLabel}${filters.zonas.length ? ` en ${filters.zonas.join(', ')}` : ''} | Real Estate Broker`;
const description = `${result.total} publicaciones de ${operacionLabel} con filtros por tipo, zona, ambientes y precio. Resultados en tiempo real sobre el motor Real Estate Broker.`;
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <nav aria-label="Migas de pan" class="mb-4 text-xs text-slate-500">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="font-medium hover:text-brand-700">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li class="font-semibold text-slate-700">Propiedades</li>
      </ol>
    </nav>

    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">
          Propiedades en {operacionLabel}
        </h1>
        <p class="mt-1 text-sm text-slate-500">
          {
            result.total === 0
              ? 'Sin resultados para los filtros seleccionados.'
              : `${result.total} ${result.total === 1 ? 'publicación encontrada' : 'publicaciones encontradas'}`
          }
          {activeCount > 0 && ` · ${activeCount} ${activeCount === 1 ? 'filtro activo' : 'filtros activos'}`}
        </p>
      </div>

      <form method="get" action="/propiedades" class="flex items-center gap-2">
        {
          [...filtersToSearchParams({ ...filters, page: 1 }).entries()]
            .filter(([key]) => key !== 'orden' && key !== 'page')
            .map(([key, value]) => <input type="hidden" name={key} value={value} />)
        }
        <label for="orden" class="text-xs font-semibold uppercase tracking-wide text-slate-500">Ordenar por</label>
        <select id="orden" name="orden" class="input-base w-auto min-w-44 py-2" onchange="this.form.submit()">
          {
            ORDENES.map((orden) => (
              <option value={orden} selected={filters.orden === orden}>
                {ORDENES_LABEL[orden]}
              </option>
            ))
          }
        </select>
        <noscript><button type="submit" class="btn-secondary py-2">Ordenar</button></noscript>
      </form>
    </div>

    {
      chips.length > 0 && (
        <div class="mt-4 flex flex-wrap items-center gap-2">
          {chips.map((chip) => (
            <a href={chip.href} class="chip hover:border-accent-300 hover:text-accent-700">
              {chip.label}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="h-3 w-3" aria-hidden="true">
                <path d="M18 6 6 18M6 6l12 12" />
              </svg>
            </a>
          ))}
          <a href="/propiedades" class="text-xs font-semibold text-accent-600 hover:underline">Limpiar filtros</a>
        </div>
      )
    }

    <div class="mt-6 grid gap-8 lg:grid-cols-[280px_minmax(0,1fr)]">
      <aside class="hidden lg:block">
        <div class="sticky top-20 card p-5">
          <FilterSidebar filters={filters} zonas={zonas} tipoCounts={tipoCounts} />
        </div>
      </aside>

      <div>
        <details class="card mb-6 p-4 lg:hidden">
          <summary class="cursor-pointer text-sm font-bold text-slate-900">
            Filtrar resultados {activeCount > 0 && `(${activeCount})`}
          </summary>
          <div class="mt-4">
            <FilterSidebar filters={filters} zonas={zonas} tipoCounts={tipoCounts} />
          </div>
        </details>

        {
          result.items.length > 0 ? (
            <>
              <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
                {result.items.map((property) => (
                  <PropertyCard property={property} />
                ))}
              </div>
              <Pagination page={result.page} totalPages={result.totalPages} filters={filters} />
            </>
          ) : (
            <div class="card flex flex-col items-center gap-3 p-12 text-center">
              <span class="flex h-14 w-14 items-center justify-center rounded-full bg-slate-100 text-slate-400">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="h-7 w-7" aria-hidden="true">
                  <circle cx="11" cy="11" r="7" />
                  <path d="m20 20-3.5-3.5M8.5 8.5l5 5m0-5-5 5" />
                </svg>
              </span>
              <h2 class="text-lg font-bold text-slate-900">No encontramos propiedades</h2>
              <p class="max-w-md text-sm text-slate-500">
                Probá ampliando el rango de precios, quitando filtros o explorando otra zona.
              </p>
              <a href="/propiedades" class="btn-primary mt-2">Limpiar filtros y volver a buscar</a>
            </div>
          )
        }
      </div>
    </div>
  </div>
</BaseLayout>
